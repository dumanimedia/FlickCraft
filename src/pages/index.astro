---
import Layout from "../layouts/main.astro";
import { Badge } from "@/components/ui/badge";
import Header from "@/components/header.astro";
import Footer from "@/components/footer.astro";
import { Button } from "@/components/ui/button";

import { Play } from "lucide-react";
---

<Layout title="FlickCraft - Movie Streaming Platform">
  <Header />
  <main>
    <section
      class="hero-section relative flex items-center justify-start min-h-screen bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/hero-bg-img.jpg');"
    >
      <div
        class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,0,0,1)15%,rgba(0,0,0,0)34%,rgba(0,0,0,0.73)69%),linear-gradient(to_right,rgba(0,0,0,1)31%,rgba(0,0,0,0)100%)] opacity-80"
      >
      </div>
      <div
        class="wrapper container mx-auto relative z-10 py-[124px] pb-[84px] pl-12"
      >
        <div
          class="hero-single-movie-info relative flex flex-col gap-6 max-w-[470px]"
        >
          <h1 class="title text-7xl font-bold">Spiderman No Way Home</h1>
          <div class="flex flex-wrap items-center gap-4 mb-6">
            <div class="flex items-center space-x-1">
              <div
                class="bg-yellow-500 text-black px-2 py-1 rounded text-sm font-bold"
              >
                IMDb
              </div>
              <span class="font-semibold">8.2</span>
              <span>(12,827)</span>
            </div>
            <span>•</span>
            <span class="text-white/80">2021</span>
            <span>•</span>
            <span class="text-white/80">1 hour 55 minutes</span>
            <span>•</span>
            <Badge variant="outline" className="border-white/30 text-white/80">
              Sci-fi
            </Badge>
          </div>
          <p>
            Scelerisque sed ultricies tristique. Mi in vivamus aliquam varius eu
            felis. Id ultricies diam turpis mi tincidunt. Ut morbi sed urna
            tempor imperdiet eu scelerisque egestas. Interdum mi orci
            suspendisse incidunt. Scelerisque sed ultricies tristique. Mi in
            vivamus aliquam varius eu felis. Id ultricies diam turpis mi
            tincidunt.
          </p>
          <div class="buttons relative flex gap-4">
            <Button variant="outline" size="lg">Watch Trailer</Button>
            <Button size="lg" className="flex items-center gap-1">
              <Play className="size-4" />
              <span>Watch now</span>
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
