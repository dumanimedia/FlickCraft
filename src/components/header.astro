---
import HeaderRightSide from "./header-rightside";
---

<header class="fixed block px-4 py-6 w-full z-50">
  <div class="relative container flex items-center justify-between mx-auto">
    <img src="/logo.svg" alt="FlickCraft-logo" />

    <nav class="navigation relative flex items-center justify-center">
      <ul class="relative flex items-center justify-center gap-8">
        <li>
          <a class="inline-block hover:text-primary transition-all" href="#">
            Home
          </a>
        </li>
        <li>
          <span class="block w-0.5 h-4 bg-foreground/75"></span>
        </li>
        <li>
          <a class="inline-block hover:text-primary transition-all" href="#">
            Movies
          </a>
        </li>
        <li>
          <span class="block w-0.5 h-4 bg-foreground/75"></span>
        </li>
        <li>
          <a class="inline-block hover:text-primary transition-all" href="#">
            Tv Shows
          </a>
        </li>
        <li>
          <span class="block w-0.5 h-4 bg-foreground/75"></span>
        </li>
        <li>
          <a class="inline-block hover:text-primary transition-all" href="#">
            Premium
          </a>
        </li>
      </ul>
    </nav>

    <HeaderRightSide client:load />
  </div>
</header>
